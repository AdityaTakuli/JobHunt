{
  "name": "archjobs",
  "version": "0.1.0",
  "private": true,
  "description": "Architecture & BIM job finder and application tracker",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "migrate": "node server/db/migrate.js",
    "task": "node server/tasks/run.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28",
    "motion": "^13.4.2",
    "mysql2": "^3.24.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
