# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development
# Public URL of the dashboard (used for links in the digest email)
PUBLIC_URL=http://localhost:3000

# --- MySQL (Hostinger: hPanel -> Databases -> MySQL Databases) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=archjobs
DB_PASSWORD=
DB_NAME=archjobs

# --- Sign-in ---
# The owner's password (opens the owner account). Empty in development = no sign-in needed.
APP_PASSWORD=
# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Encrypts stored Gmail access (another long random string). Falls back to SESSION_SECRET.
TOKEN_SECRET=

# --- Google sign-in and Gmail job alerts (console.cloud.google.com -> APIs & Services) ---
# OAuth client ("Web application") with redirect URI <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The owner's Google account: signing in with it opens the owner account.
OWNER_EMAIL=
# Others who may manage access (Settings > People). Comma-separated.
ADMIN_EMAILS=
# Who else may sign in with Google: comma-separated emails, or * for anyone with a Google account.
# Admins can also add people in Settings > People.
ALLOWED_EMAILS=

# --- Scheduling: pick ONE ---
# a) node-cron inside the app process
ENABLE_SCHEDULER=true
# b) Hostinger cron calling https://your-site/api/cron/<task>?key=CRON_SECRET
CRON_SECRET=

# --- SerpApi Google Jobs (https://serpapi.com/manage-api-key) ---
SERPAPI_KEY=
# Free plan = 250 searches/month. Fetching pauses when SERPAPI_RESERVE searches are left.
SERPAPI_MONTHLY_LIMIT=250
SERPAPI_RESERVE=10
SERPAPI_QUERIES_PER_RUN=3
# Searches typed on the Jobs page per day (a repeat within 6 hours is free)
SERPAPI_MANUAL_DAILY_LIMIT=10

# --- AI classifier: FreeLLMAPI first, then Groq, then Gemini, keyword rules when all are out ---
# FreeLLMAPI: your own gateway (llm.velocitytechnologies.in). Key = the unified key from its
# Keys page. Leave the URL or key empty to skip it.
FREELLM_URL=https://llm.velocitytechnologies.in
FREELLM_API_KEY=
# A model id, or auto / auto:smart to let FreeLLMAPI choose
FREELLM_MODEL=openai/gpt-oss-120b
FREELLM_REASONING_EFFORT=low

# Groq: https://console.groq.com/keys  (free tier: 1,000 requests/day, 8,000 tokens/minute)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# "none" = no thinking tokens (Qwen). gpt-oss models take low/medium/high. Empty = omit.
GROQ_REASONING_EFFORT=none

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal

# --- Token guardrails. A call that would go past any limit is not made: the job gets keyword
# rules and the hourly retry-classify re-labels it once budget is back. Days are IST days. ---
FREELLM_DAILY_TOKEN_LIMIT=300000
FREELLM_DAILY_REQUEST_LIMIT=1000
FREELLM_MINUTE_TOKEN_LIMIT=15000
FREELLM_RUN_TOKEN_LIMIT=80000
GROQ_DAILY_TOKEN_LIMIT=150000
GROQ_DAILY_REQUEST_LIMIT=900
GROQ_MINUTE_TOKEN_LIMIT=7000
# Per task run ("session"): one fetch / inbox read / retry may spend at most this much
GROQ_RUN_TOKEN_LIMIT=40000
GEMINI_DAILY_TOKEN_LIMIT=100000
GEMINI_DAILY_REQUEST_LIMIT=200
GEMINI_MINUTE_TOKEN_LIMIT=30000
GEMINI_RUN_TOKEN_LIMIT=25000
# Descriptions are cut to this many characters before they are sent
AI_MAX_DESCRIPTION_CHARS=2500
# Longest wait (ms) for the per-minute window before a job falls back
AI_MAX_WAIT_MS=30000

# --- Mailbox that receives forwarded LinkedIn job alerts (Hostinger email) ---
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# --- Outgoing mail for the daily digest (Hostinger SMTP or Brevo) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
