# Dependencies. web/dist IS committed: Vite's native bundler cannot run on Hostinger shared
# hosting, so the web app is built locally (the pre-commit hook does it) and deployed as files.
node_modules/

# Secrets: set these in hPanel's environment settings, never commit them
.env
.env.*
hostinger.env
!.env.example

# Logs, editors, OS
*.log
coverage/
.vscode/
.idea/
.DS_Store
Thumbs.db
